"""A scantor task: one analysis per origin of a CrUX top list (template crux)."""

from pydantic import BaseModel

import scantor
from scantor import templates


class TaskConfig(scantor.Config):
    """Task config: set per scan, the same for all its analyses. Give every field a default."""

    greeting: str = "Hello"


class Result(BaseModel):
    """The result of one analysis."""

    text: str


def run(ctx: scantor.Context, analysis_config: templates.crux.AnalysisConfig, task_config: TaskConfig) -> Result:
    ctx.log("info", "analysing", origin=analysis_config.origin, rank=analysis_config.rank)
    return Result(text=f"{task_config.greeting}, {analysis_config.origin} (bucket {analysis_config.rank})!")


# The template's proxy, passed unwrapped: the platform schedules natively with the template's scan
# config, and run receives the template's analysis configs.
task = scantor.Task(task_config=TaskConfig, result=Result, schedule=templates.crux.schedule, run=run)
