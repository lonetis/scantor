{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "scantor: attach to dev debug",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}", "remoteRoot": "/task" }],
      "justMyCode": true
    }
  ]
}
