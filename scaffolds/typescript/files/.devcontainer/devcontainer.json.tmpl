{
  "name": "[[.Name]]",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": { "SCANTOR_BASE": "[[.BaseImage]]" }
  },
  "workspaceFolder": "/task",
  "workspaceMount": "source=${localWorkspaceFolder},target=/task,type=bind",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "redhat.vscode-yaml"],
      "settings": {
        "typescript.tsdk": "/node_modules/typescript/lib",
        "yaml.schemas": { "[[.ManifestSchemaURL]]": "scantor.yaml" }
      }
    }
  }
}
