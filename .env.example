################################################################################
#                                                                              #
#                       scantor environment configuration                      #
#                                                                              #
################################################################################
#
# This file is the only documentation of scantor's environment variables. Every
# variable is listed with its default, and the defaults run a local development
# stack as they are.
#
# Setup: `just init` copies this file to .env (or appends the variables that .env
# lacks) and replaces every value ending in "-insecure-dev" with a random one. It
# never changes a value that already exists in .env. Without just, copy the file
# and replace each "-insecure-dev" value with the output of `openssl rand -hex 24`
# (48 hex characters, the same as `just init`).
#
# The compose files contain no defaults, so .env must stay complete.
#
# Value syntax:
#   booleans    true / false
#   lists       comma-separated, whitespace trimmed, empty entries dropped
#   durations   Go syntax: 500ms, 30s, 15m, 24h
#   byte sizes  an integer with an optional KiB, MiB, GiB or TiB suffix
#   *_DAYS      whole days
#
# Variables that scantor sets itself for its own containers (worker credentials,
# the base-image contract, the connector protocol) are not configuration and are
# not listed here.


# ══════════════════════════════════════════════════════════════════════════════
#   CORE URLS
# ══════════════════════════════════════════════════════════════════════════════
# With Traefik, set these to https URLs (see "TRAEFIK & TLS").

# Public origin of the dashboard, REST API and MCP server
SCANTOR_PUBLIC_URL=http://localhost:3000

# Origin of the browser editor; must differ from SCANTOR_PUBLIC_URL (Traefik: https://editor.<domain>)
SCANTOR_EDITOR_URL=http://localhost:3001

# Orchestrator URL on the compose networks (built-in node, its workers, editors)
SCANTOR_INTERNAL_URL=http://orchestrator:3000


# ══════════════════════════════════════════════════════════════════════════════
#   SECRETS
# ══════════════════════════════════════════════════════════════════════════════
# Development values end in "-insecure-dev". In a public deployment (a URL or bind
# address that is not loopback, or the traefik profile) the orchestrator refuses
# to start while any value ends in "-insecure-dev" or a core secret is shorter
# than 16 characters. `just init` generates random values; by hand:
#   openssl rand -hex 24

# Root secret: every internal key derives from it. Changing it later is a disaster-recovery operation
SCANTOR_SECRET=scantor-secret-insecure-dev

# true lets a public deployment start with insecure secrets (warning only); never in production
SCANTOR_ALLOW_INSECURE_DEFAULTS=false


# ══════════════════════════════════════════════════════════════════════════════
#   FIRST ADMIN
# ══════════════════════════════════════════════════════════════════════════════
# Used only while no user exists. Leave both empty to create the first admin
# through the one-time setup link in the orchestrator logs (grep /setup).

# Email of the first admin, created at boot (headless installs)
SCANTOR_ADMIN_EMAIL=

# Password of the first admin (at least 16 characters in a public deployment)
SCANTOR_ADMIN_PASSWORD=


# ══════════════════════════════════════════════════════════════════════════════
#   NETWORK & PORTS
# ══════════════════════════════════════════════════════════════════════════════
# Host ports of the master. Public services bind to SCANTOR_BIND_ADDRESS; admin
# GUIs and MongoDB bind to SCANTOR_ADMIN_BIND_ADDRESS (reach them through an SSH
# tunnel). A non-loopback address makes the deployment public for the startup
# guard. With Traefik, keep both on loopback: only Traefik faces the network.

# Host address of the dashboard, editor, AMQP, S3 and registry ports; must include loopback
SCANTOR_BIND_ADDRESS=127.0.0.1

# Host address of the MongoDB, mongo-express, RabbitMQ management and RustFS console ports
SCANTOR_ADMIN_BIND_ADDRESS=127.0.0.1

# Host port of the dashboard, API and MCP (orchestrator container port 3000)
SCANTOR_PORT=3000

# Host port of the editor origin (orchestrator container port 3001)
SCANTOR_EDITOR_PORT=3001

# Host port of AMQP (remote workers without Traefik)
SCANTOR_AMQP_PORT=5672

# Host port of the RustFS S3 API (presigned uploads and downloads)
SCANTOR_S3_PORT=9000

# Host port of the registry; the master's Docker daemon pushes and pulls via localhost:<port>
SCANTOR_REGISTRY_PORT=5000

# Host port of the RabbitMQ management UI (admin address)
SCANTOR_RABBITMQ_MANAGEMENT_PORT=15672

# Host port of the RustFS console (admin address)
SCANTOR_RUSTFS_CONSOLE_PORT=9001

# Host port of mongo-express (admin address)
SCANTOR_MONGO_EXPRESS_PORT=8081

# Host port of MongoDB; clients need directConnection=true (admin address)
SCANTOR_MONGO_PORT=27017


# ══════════════════════════════════════════════════════════════════════════════
#   ENDPOINTS
# ══════════════════════════════════════════════════════════════════════════════
# Service endpoints. The built-in node and its workers get the internal ones;
# remote nodes, their workers and browsers get the public ones.

# MongoDB replica-set URL without credentials (orchestrator)
SCANTOR_MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0&authSource=admin

# RabbitMQ management API (orchestrator)
SCANTOR_RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# AMQP endpoint of the orchestrator and built-in node workers (no credentials, no vhost)
SCANTOR_AMQP_INTERNAL_URL=amqp://rabbitmq:5672

# AMQP endpoint of remote workers (Traefik: amqps://amqp.<domain>:443)
SCANTOR_AMQP_PUBLIC_URL=amqp://localhost:5672

# S3 endpoint of the orchestrator and of built-in node workers' presigned uploads
SCANTOR_S3_INTERNAL_URL=http://rustfs:9000

# S3 endpoint of browsers and remote workers; a host without path (Traefik: https://s3.<domain>)
SCANTOR_S3_PUBLIC_URL=http://localhost:9000

# Registry host[:port] that remote nodes pull task images from (Traefik: registry.<domain>)
SCANTOR_REGISTRY_PUBLIC_HOST=localhost:5000

# RustFS console URL, used as its CORS origin and login redirect (Traefik: https://rustfs.<domain>)
SCANTOR_RUSTFS_CONSOLE_URL=http://localhost:9001


# ══════════════════════════════════════════════════════════════════════════════
#   INFRASTRUCTURE CREDENTIALS
# ══════════════════════════════════════════════════════════════════════════════
# Root credentials of the bundled services. Only the orchestrator uses them.
#
# FIRST INIT ONLY: MongoDB and RabbitMQ apply their root user and password only
# when their data volume is initialised for the first time. Changing them in .env
# afterwards locks the orchestrator out, and a leaked default stays valid until
# it is rotated by hand (docs/deployment.md §14.3).

# ── MongoDB ───────────────────────────────────────────────────────────────────

# MongoDB root user (FIRST INIT ONLY)
SCANTOR_MONGO_USER=scantor

# MongoDB root password (FIRST INIT ONLY); URL-safe characters only
SCANTOR_MONGO_PASSWORD=mongo-insecure-dev

# Application database
SCANTOR_MONGO_DB=scantor

# Read-only analytics user, created only when SCANTOR_EXPOSE_MONGO=true
SCANTOR_MONGO_ANALYTICS_USER=scantor_analytics

# Password of the analytics user (applied at every orchestrator start)
SCANTOR_MONGO_ANALYTICS_PASSWORD=mongo-analytics-insecure-dev

# ── RabbitMQ ──────────────────────────────────────────────────────────────────

# RabbitMQ admin user (FIRST INIT ONLY)
SCANTOR_RABBITMQ_USER=scantor

# RabbitMQ admin password (FIRST INIT ONLY)
SCANTOR_RABBITMQ_PASSWORD=rabbitmq-insecure-dev

# ── RustFS (S3) ───────────────────────────────────────────────────────────────

# RustFS root access key (applied at every start)
SCANTOR_S3_ACCESS_KEY=scantor

# RustFS root secret key (applied at every start)
SCANTOR_S3_SECRET_KEY=rustfs-insecure-dev

# Private bucket for snapshots, files, exports and logs (created at boot)
SCANTOR_S3_BUCKET=scantor

# ── mongo-express ─────────────────────────────────────────────────────────────

# mongo-express basic-auth user
SCANTOR_MONGO_EXPRESS_USER=admin

# mongo-express basic-auth password
SCANTOR_MONGO_EXPRESS_PASSWORD=mongo-express-insecure-dev

# mongo-express cookie and session secret
SCANTOR_MONGO_EXPRESS_SECRET=mongo-express-secret-insecure-dev

# Keep true: mongo-express is unmaintained and connects with the MongoDB root user
SCANTOR_MONGO_EXPRESS_READONLY=true


# ══════════════════════════════════════════════════════════════════════════════
#   TRAEFIK & TLS
# ══════════════════════════════════════════════════════════════════════════════
# Optional TLS termination of every public endpoint on :443 with one wildcard
# certificate for SCANTOR_DOMAIN and *.SCANTOR_DOMAIN. To enable it, set
# COMPOSE_PROFILES=traefik, SCANTOR_DOMAIN, SCANTOR_TRUST_PROXY=true,
# SCANTOR_TRAEFIK_CERT_RESOLVER=acme with a DNS provider token, and the https and
# amqps URLs of "CORE URLS" and "ENDPOINTS" (checklist: docs/deployment.md §7.7).
# DNS needs records for <domain> and *.<domain>. Hosts are fixed: <domain>,
# editor., registry., s3., amqp., mongo., rabbitmq., mongo-express., rustfs. and
# traefik.<domain>. Disable CDN proxying for s3.<domain>.

# Compose profiles; "traefik" starts Traefik and makes the deployment public for the startup guard
COMPOSE_PROFILES=

# Base domain served by Traefik and Domain of the admin-tools cookie; empty = no Traefik
SCANTOR_DOMAIN=

# true trusts X-Forwarded-For; only when every request arrives through Traefik
SCANTOR_TRUST_PROXY=false

# Host address of Traefik's HTTP and HTTPS ports
SCANTOR_TRAEFIK_BIND_ADDRESS=0.0.0.0

# Host port of the HTTP entrypoint (redirects to HTTPS)
SCANTOR_HTTP_PORT=80

# Host port of the HTTPS entrypoint (HTTP routers plus AMQPS and MongoDB by SNI)
SCANTOR_HTTPS_PORT=443

# Read timeout of the HTTPS entrypoint; must cover the slowest large S3 upload
SCANTOR_TRAEFIK_READ_TIMEOUT=30m

# Traefik log level (DEBUG, INFO, WARN, ERROR)
SCANTOR_TRAEFIK_LOG_LEVEL=INFO

# Traefik access log on stdout
SCANTOR_TRAEFIK_ACCESS_LOG=false

# Route MongoDB through Traefik (mongo.<domain>:443, read-only analytics user; bypasses user scoping)
SCANTOR_EXPOSE_MONGO=false

# ── Certificates (ACME DNS-01) ────────────────────────────────────────────────

# "acme" requests certificates; empty serves Traefik's self-signed default certificate (local use only)
SCANTOR_TRAEFIK_CERT_RESOLVER=

# ACME account email (optional)
SCANTOR_ACME_EMAIL=

# ACME directory; staging: https://acme-staging-v02.api.letsencrypt.org/directory
SCANTOR_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# DNS provider (lego name; list: https://doc.traefik.io/traefik/https/acme/#providers)
SCANTOR_ACME_DNS_PROVIDER=cloudflare

# Public resolvers for the DNS propagation check
SCANTOR_ACME_DNS_RESOLVERS=1.1.1.1:53,1.0.0.1:53

# Wait before the DNS propagation check
SCANTOR_ACME_DNS_DELAY=10s

# ── Cloudflare (default DNS provider) ─────────────────────────────────────────
# Another provider: set SCANTOR_ACME_DNS_PROVIDER and add that provider's lego
# variables to .env (https://go-acme.github.io/lego/dns/); Traefik reads .env.

# Cloudflare API token for the DNS-01 challenge. Create it at
# https://dash.cloudflare.com/profile/api-tokens -> Create Token -> template
# "Edit zone DNS". Permissions: Zone / DNS / Edit and Zone / Zone / Read.
# Zone resources: Include / Specific zone / <your zone>.
CF_DNS_API_TOKEN=


# ══════════════════════════════════════════════════════════════════════════════
#   ORCHESTRATOR
# ══════════════════════════════════════════════════════════════════════════════

# ── Images ────────────────────────────────────────────────────────────────────

# Registry prefix of scantor images, with trailing "/"; empty = locally built images (dev stack)
SCANTOR_IMAGE_PREFIX=ghcr.io/lonetis/

# Tag of scantor images; pin a release such as 1.4.0 in production (the dev stack uses dev)
SCANTOR_IMAGE_TAG=latest

# ── Process ───────────────────────────────────────────────────────────────────

# Components this orchestrator runs (subset of api, ingestor, reconciler)
SCANTOR_COMPONENTS=api,ingestor,reconciler

# Log level of the orchestrator and node daemons (debug, info, warn, error)
SCANTOR_LOG_LEVEL=info

# Log format of the orchestrator and node daemons (json, text)
SCANTOR_LOG_FORMAT=json

# Passkey relying-party ID; empty = host of SCANTOR_PUBLIC_URL (changing it voids existing passkeys)
SCANTOR_PASSKEY_RP_ID=

# ── Nodes and placement ───────────────────────────────────────────────────────

# Interval of node status reports
SCANTOR_NODE_STATUS_INTERVAL=10s

# Long-poll wait of a node's assignments request
SCANTOR_NODE_ASSIGNMENTS_WAIT=25s

# A node without a status report for this long is offline and its workers are replaced
SCANTOR_NODE_OFFLINE_AFTER=60s

# Nodes with less free disk get no new workers and run an emergency image GC
SCANTOR_NODE_MIN_FREE_DISK=5GiB

# Nodes that may pull the same new image at once (cluster-wide)
SCANTOR_PLACEMENT_MAX_CONCURRENT_PULLS=4

# Time workers get to finish in-flight analyses when they stop (pause, scale down)
SCANTOR_WORKER_DRAIN_GRACE=30s

# Capabilities added to every worker (subset of NET_BIND_SERVICE, NET_RAW; empty = none)
SCANTOR_WORKER_CAP_ADD=NET_BIND_SERVICE,NET_RAW

# ── Retention and maintenance ─────────────────────────────────────────────────

# Days the tombstone of a deleted scan is kept
SCANTOR_TOMBSTONE_DAYS=7

# Days events are kept
SCANTOR_EVENTS_TTL_DAYS=30

# Days background exports are kept
SCANTOR_EXPORT_RETENTION_DAYS=7

# Interval of the automatic registry garbage collection (0 disables)
SCANTOR_REGISTRY_GC_INTERVAL=24h


# ══════════════════════════════════════════════════════════════════════════════
#   LIMITS
# ══════════════════════════════════════════════════════════════════════════════

# ── Master resources ──────────────────────────────────────────────────────────

# Memory limit of the orchestrator container
SCANTOR_ORCHESTRATOR_MEMORY_LIMIT=2GiB

# Memory limit of the orchestrator container of the dev stack (docker-compose.dev.yml): `nuxt dev`
# (Vite and the Nitro builder) needs about twice the memory of the production server, and Node
# sizes its heap to about half of the limit
SCANTOR_DEV_ORCHESTRATOR_MEMORY_LIMIT=4GiB

# MongoDB WiredTiger cache, in GB (mongod's own unit)
SCANTOR_MONGO_CACHE_GB=1

# Memory limit of the MongoDB container
SCANTOR_MONGO_MEMORY_LIMIT=2GiB

# RabbitMQ memory alarm (absolute): publishers are blocked above it
SCANTOR_RABBITMQ_MEMORY_WATERMARK=1536MiB

# Memory limit of the RabbitMQ container; keep it about 30 % above the watermark
SCANTOR_RABBITMQ_MEMORY_LIMIT=2GiB

# RabbitMQ disk alarm: publishers are blocked below this free disk (production: at least 5GiB)
SCANTOR_RABBITMQ_DISK_FREE_LIMIT=2GiB

# ── API ───────────────────────────────────────────────────────────────────────

# Max size of a JSON request body
SCANTOR_MAX_REQUEST_BYTES=10MiB

# Max size of an uploaded list file
SCANTOR_MAX_UPLOAD_BYTES=100MiB

# Max size of a task config and of a scan config (each)
SCANTOR_MAX_SCAN_CONFIG_BYTES=1MiB

# Concurrent wait (long-poll) requests per user
SCANTOR_MAX_CONCURRENT_WAITS=20

# Max run time of a results query or aggregation
SCANTOR_QUERY_MAX_TIME=30s

# Max documents a results query or aggregation returns
SCANTOR_QUERY_MAX_DOCS=10000

# Concurrent queries, aggregations and exports per user
SCANTOR_USER_MAX_CONCURRENT_QUERIES=4

# Max analyses of an inline export; larger exports run in the background
SCANTOR_EXPORT_INLINE_MAX=50000

# ── Scans, results and files ──────────────────────────────────────────────────

# Max analyses per scan
SCANTOR_MAX_ANALYSES_PER_SCAN=20000000

# Max runner workers per scan
SCANTOR_MAX_WORKERS_PER_SCAN=100

# Max connector processes per worker
SCANTOR_MAX_PROCESSES_PER_WORKER=64

# Max active workers of a new user across all scans (0 = unlimited; admins can change it per user)
SCANTOR_USER_MAX_WORKERS=0

# Max size of a single analysis config
SCANTOR_MAX_ANALYSIS_CONFIG_BYTES=64KiB

# Max size of a single result (keep it below 2MiB, the result message limit)
SCANTOR_MAX_RESULT_BYTES=1MiB

# Max size of a single file
SCANTOR_MAX_FILE_BYTES=1GiB

# Max files per analysis
SCANTOR_MAX_FILES_PER_ANALYSIS=100

# File storage quota per user (0 = unlimited)
SCANTOR_USER_STORAGE_QUOTA_BYTES=0

# Lifetime of presigned upload URLs and timeout of each upload
SCANTOR_UPLOAD_TIMEOUT=15m

# A worker stops taking analyses below this free space in /tmp/scantor
SCANTOR_WORKER_MIN_FREE_TMP_BYTES=1GiB


# ══════════════════════════════════════════════════════════════════════════════
#   BUILDS & TASK PIPELINE
# ══════════════════════════════════════════════════════════════════════════════

# Max duration of one image build
SCANTOR_BUILD_TIMEOUT=30m

# Concurrent builds on the master (revision and test-run builds together)
SCANTOR_BUILD_CONCURRENCY=2

# Max size of a built task image
SCANTOR_MAX_IMAGE_BYTES=10GiB

# Size the BuildKit cache is pruned to after each build
SCANTOR_BUILD_CACHE_MAX_BYTES=20GiB

# Timeout of each describe and check container (must exceed the runtime's own 5m check limit)
SCANTOR_DESCRIBE_TIMEOUT=10m

# Max compressed size of a task upload
SCANTOR_TASK_MAX_PACK_BYTES=50MiB

# Max files in a task folder
SCANTOR_TASK_MAX_FILES=5000

# Max uncompressed size of a task folder
SCANTOR_TASK_MAX_BYTES=200MiB

# ── Test runs ─────────────────────────────────────────────────────────────────

# Max total duration of one test run
SCANTOR_TEST_RUN_TIMEOUT=10m

# Concurrent test runs on the master
SCANTOR_TEST_RUN_CONCURRENCY=2

# Days test-run logs and files are kept
SCANTOR_TEST_RUN_RETENTION_DAYS=7

# Age after which unused draft images (test-run builds) are removed
SCANTOR_DRAFT_IMAGE_RETENTION=24h


# ══════════════════════════════════════════════════════════════════════════════
#   SCANS & QUEUE
# ══════════════════════════════════════════════════════════════════════════════
# SCANTOR_DELIVERY_LIMIT and SCANTOR_SCAN_QUEUE_MAX_READY apply to queues of scans
# started after a change.

# Deliveries of one analysis before it is dead-lettered as a crash (poison message guard)
SCANTOR_DELIVERY_LIMIT=10

# Max ready messages per scan queue; the scheduler waits while it is full
SCANTOR_SCAN_QUEUE_MAX_READY=100000

# Scans estimated above this many analyses need an explicit confirmation to start
SCANTOR_SCAN_CONFIRM_THRESHOLD=100000

# Scheduler restarts before scheduling fails
SCANTOR_SCHEDULER_MAX_RESTARTS=3

# A scheduled scan idle this long (empty queue, no busy worker) gets missing analyses marked lost
SCANTOR_SCAN_STALL_AFTER=5m


# ══════════════════════════════════════════════════════════════════════════════
#   INGESTOR
# ══════════════════════════════════════════════════════════════════════════════

# Unacked result messages the ingestor holds (memory: up to prefetch x 2MiB)
SCANTOR_INGEST_PREFETCH=1000

# Messages per ingest batch
SCANTOR_INGEST_BATCH_SIZE=500

# Max time a result waits in a batch before it is written
SCANTOR_INGEST_FLUSH_INTERVAL=1s

# A batch is written early once it holds this many message bytes
SCANTOR_INGEST_BATCH_MAX_BYTES=16MiB

# ── Failure-rate breaker (auto-pause) ─────────────────────────────────────────

# Attempts in the window before the breaker can trip (0 disables it)
SCANTOR_BREAKER_MIN_ATTEMPTS=100

# Failure ratio in the window that pauses a scan
SCANTOR_BREAKER_RATIO=0.95

# Length of the breaker's sliding window
SCANTOR_BREAKER_WINDOW=5m


# ══════════════════════════════════════════════════════════════════════════════
#   NODES (BUILT-IN)
# ══════════════════════════════════════════════════════════════════════════════
# The built-in node daemon on the master. The worker container settings below
# apply to it; remote nodes read the same names from their own environment.

# Max concurrent workers on the master, which they share with MongoDB, RabbitMQ and builds
SCANTOR_BUILTIN_NODE_MAX_WORKERS=2

# DinD mode of the built-in node: disabled, sysbox or privileged. Keep it disabled:
# enabling it on the master makes every user allowed to run privileged tasks root on the platform.
SCANTOR_BUILTIN_NODE_DIND=disabled

# ── Worker containers (every node daemon) ─────────────────────────────────────

# CIDRs workers must not reach (cloud metadata); add RFC 1918 ranges on internet-only nodes; empty = off
SCANTOR_NODE_EGRESS_DENY=169.254.0.0/16,fd00:ec2::254/128,100.100.100.200/32

# PIDs limit of each worker container
SCANTOR_NODE_PIDS_LIMIT=4096

# /dev/shm size of each worker container (counts against its memory limit)
SCANTOR_NODE_SHM_SIZE=256MiB

# nofile ulimit (soft and hard) of each worker container
SCANTOR_NODE_NOFILE=65536

# Max size of one worker log file
SCANTOR_NODE_WORKER_LOG_MAX_SIZE=20MiB

# Log files kept per worker
SCANTOR_NODE_WORKER_LOG_MAX_FILES=3

# Time after which unreferenced task and base images are removed
SCANTOR_NODE_IMAGE_RETENTION=24h

# Max duration of one image pull
SCANTOR_NODE_PULL_TIMEOUT=30m


# ══════════════════════════════════════════════════════════════════════════════
#   REMOTE NODE
# ══════════════════════════════════════════════════════════════════════════════
# Settings of `scantor node` on a remote Docker host, passed with `docker run -e`
# or in the node's compose file (Admin -> Nodes -> Add node shows both). A remote
# node also needs SCANTOR_URL (see "CLI") set to SCANTOR_PUBLIC_URL, and accepts the
# worker container settings of "NODES (BUILT-IN)". Never give it SCANTOR_SECRET.

# Node token (snt_...), shown once by Admin -> Nodes -> Add node or Rotate token
SCANTOR_NODE_TOKEN=

# true only for the master's built-in node (the compose file sets it); never with a node token
SCANTOR_NODE_BUILTIN=false

# Max concurrent workers on this node (0 = number of CPUs)
SCANTOR_NODE_MAX_WORKERS=0

# DinD mode: disabled, sysbox (preferred, no host root) or privileged (root on the node host)
SCANTOR_NODE_DIND=disabled

# Extra trusted CA certificates (PEM) for node daemons, workers, the CLI and git imports.
# In .env write one double-quoted line with \n escapes: awk '{printf "%s\\n", $0}' ca.pem
SCANTOR_CA_CERT=

# true allows plaintext to public hosts (loopback, RFC 1918, CGNAT and ULA are always allowed).
# The orchestrator reads it too: true silences its boot warning about plaintext public endpoints.
SCANTOR_ALLOW_INSECURE_TRANSPORT=false


# ══════════════════════════════════════════════════════════════════════════════
#   EDITOR
# ══════════════════════════════════════════════════════════════════════════════
# Per-user browser editors (code-server containers) started by the orchestrator.

# An editor without requests or open WebSockets for this long is stopped
SCANTOR_EDITOR_IDLE_TIMEOUT=30m

# Max editors starting or running at once
SCANTOR_EDITOR_MAX_RUNNING=10

# Max time an editor may take to become ready
SCANTOR_EDITOR_START_TIMEOUT=60s

# Lifetime of the editor's API key (new key per start; the editor stops 5 min before it expires)
SCANTOR_EDITOR_API_KEY_TTL=168h

# Memory limit of each editor container
SCANTOR_EDITOR_MEMORY_LIMIT=2GiB

# CPUs of each editor container
SCANTOR_EDITOR_CPUS=2

# PIDs limit of each editor container
SCANTOR_EDITOR_PIDS_LIMIT=1024

# Size of the /tmp tmpfs of each editor container
SCANTOR_EDITOR_TMPFS_SIZE=512MiB

# ── Workspace helpers ─────────────────────────────────────────────────────────

# Max size of one user's workspace
SCANTOR_WORKSPACE_MAX_BYTES=2GiB

# Concurrent workspace helper containers
SCANTOR_HELPER_CONCURRENCY=8

# Memory limit of each workspace helper container
SCANTOR_HELPER_MEMORY_LIMIT=512MiB

# PIDs limit of each workspace helper container
SCANTOR_HELPER_PIDS_LIMIT=256

# Max run time of one workspace helper
SCANTOR_HELPER_TIMEOUT=5m


# ══════════════════════════════════════════════════════════════════════════════
#   GIT
# ══════════════════════════════════════════════════════════════════════════════

# true allows git imports from loopback, private, link-local, CGNAT and ULA hosts
SCANTOR_GIT_ALLOW_PRIVATE=false


# ══════════════════════════════════════════════════════════════════════════════
#   MCP
# ══════════════════════════════════════════════════════════════════════════════

# Enables the MCP server at /mcp
SCANTOR_MCP_ENABLED=true

# Extra https origins allowed as MCP OAuth redirect URIs (loopback redirects are always allowed)
SCANTOR_MCP_ALLOWED_REDIRECT_ORIGINS=


# ══════════════════════════════════════════════════════════════════════════════
#   DATA SOURCES (TEMPLATES)
# ══════════════════════════════════════════════════════════════════════════════
# Used by schedulers, test runs and `scantor dev run`.

# Base URL of the Tranco list API (tranco template)
SCANTOR_TRANCO_URL=https://tranco-list.eu

# Base URL of the CrUX top lists (crux template)
SCANTOR_CRUX_URL=https://raw.githubusercontent.com/zakird/crux-top-lists/main


# ══════════════════════════════════════════════════════════════════════════════
#   CLI
# ══════════════════════════════════════════════════════════════════════════════
# The `scantor` CLI reads these from the shell environment, not from .env. Create
# an API key on the "CLI & MCP access" page (<SCANTOR_PUBLIC_URL>/account/access),
# which also shows ready-to-paste export lines.
#
# The CLI also reads SCANTOR_CA_CERT ("REMOTE NODE"), SCANTOR_TRANCO_URL and
# SCANTOR_CRUX_URL ("DATA SOURCES") for local runs, SCANTOR_MAX_WORKERS_PER_SCAN and
# SCANTOR_MAX_PROCESSES_PER_WORKER ("LIMITS") for manifest checks,
# SCANTOR_IMAGE_PREFIX with SCANTOR_IMAGE_TAG ("ORCHESTRATOR") when the tag is
# set, and, for `validate`, `dev run` and `dev debug`, the task-pipeline limits of
# "BUILDS & TASK PIPELINE" (SCANTOR_BUILD_TIMEOUT, SCANTOR_MAX_IMAGE_BYTES,
# SCANTOR_BUILD_CACHE_MAX_BYTES, SCANTOR_DESCRIBE_TIMEOUT and the three
# SCANTOR_TASK_MAX_* limits; not SCANTOR_BUILD_CONCURRENCY or the test-run
# variables) plus SCANTOR_PUBLIC_URL ("CORE URLS") and SCANTOR_REGISTRY_PUBLIC_HOST
# ("ENDPOINTS"; registry hosts are rejected by Dockerfile rule D5). Leave those
# unset for a native CLI: it then uses its built-in defaults.

# Orchestrator base URL of the CLI and of remote node daemons
SCANTOR_URL=http://localhost:3000

# CLI credential: an API key (sk_scantor_...) from "CLI & MCP access"
SCANTOR_TOKEN=

# How `scantor dev run` executes: local (local Docker) or remote (platform test run; the editor sets it)
SCANTOR_DEV_MODE=local

# Workspace root inside the editor; within it `scantor push` only publishes (the editor sets it)
SCANTOR_WORKSPACE=


# ══════════════════════════════════════════════════════════════════════════════
#   TESTS
# ══════════════════════════════════════════════════════════════════════════════
# Settings of the dockerized test suite (`just test-e2e`). Values exported in the
# shell win over .env.

# Playwright workers
SCANTOR_TEST_WORKERS=4

# true keeps the test stack running after the suite (iterate with `just test-exec`)
SCANTOR_TEST_KEEP_ALIVE=false

# true requires the test images to exist instead of building them in the runner
SCANTOR_TEST_SKIP_BUILD=false

# Directory in the runner with image tarballs to load instead of building (CI)
SCANTOR_TEST_IMAGES_DIR=

# Host uid that owns the test reports (`just test-e2e` sets it from id -u)
SCANTOR_TEST_HOST_UID=

# Host gid that owns the test reports (`just test-e2e` sets it from id -g)
SCANTOR_TEST_HOST_GID=

# true runs the orchestrator integration tests (orchestrator/test/**/*.integration.test.ts) against
# the MongoDB, RabbitMQ and RustFS of the usual connection variables; use throwaway services only
# (`just test-orchestrator-integration` starts them and sets it)
SCANTOR_TEST_INTEGRATION=false

# Scantor image <prefix>scantor:<tag> (the prefix ends in "/") for the orchestrator's workspace
# helper and task build integration tests; empty skips them
SCANTOR_TEST_SCANTOR_IMAGE=

# Host build of ./cmd/scantor for the orchestrator's task build integration test (together with
# SCANTOR_TEST_SCANTOR_IMAGE); empty skips it
SCANTOR_TEST_SCANTOR_BINARY=

# true on CI systems (GitHub Actions sets it): one retry for diagnostics, flaky tests fail
CI=
