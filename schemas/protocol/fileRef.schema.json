{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scantor.dev/schemas/protocol/fileRef.schema.json",
  "title": "fileRef (runtime → connector)",
  "description": "Reply to `file`: the file's reference (id generated by the runtime), returned to user code by ctx.files.put.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "fileRef"
  ],
  "properties": {
    "type": {
      "const": "fileRef"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "fileRef": {
      "$ref": "common.schema.json#/$defs/fileRef"
    }
  },
  "examples": [
    {
      "type": "fileRef",
      "id": "c3",
      "fileRef": {
        "id": "e0c4b2a1-9f8e-4d7c-8b6a-5f4e3d2c1b0a",
        "name": "shot.png",
        "size": 48213,
        "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        "contentType": "image/png"
      }
    }
  ]
}
