{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lonetis/scantor/main/schemas/messages/attempt.schema.json",
  "title": "Attempt message",
  "description": "Body of an AMQP message on exchange scantor.results (routing key <scanId>, AMQP user_id scan-<scanId>, type attempt), consumed by the ingestor from scantor.results.ingest. Published by a runner for a retryable failure that will be retried, right before the delayed republish of the analysis. The ingestor sets the analysis status to retrying. attempt is the number of the attempt that failed. See docs/queue.md section 5.4.",
  "type": "object",
  "required": [
    "v", "kind", "analysisId", "scanId", "seq", "round", "attempt", "executionId", "workerId", "nodeId",
    "config", "error", "logTail", "timings"
  ],
  "properties": {
    "v": { "const": 1 },
    "kind": { "const": "attempt" },
    "analysisId": {
      "description": "<scanId>-<seq>.",
      "$ref": "#/$defs/analysisId"
    },
    "scanId": { "$ref": "#/$defs/uuid" },
    "seq": { "$ref": "#/$defs/seq" },
    "round": { "type": "integer", "minimum": 1 },
    "attempt": {
      "description": "The attempt that failed; the republished analysis carries attempt + 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 19
    },
    "executionId": { "$ref": "#/$defs/uuid" },
    "workerId": { "$ref": "#/$defs/uuid" },
    "nodeId": { "$ref": "#/$defs/uuid" },
    "config": {
      "description": "The analysis config, copied from the analysis message.",
      "type": "object"
    },
    "error": {
      "description": "The error of the failed attempt; always retryable.",
      "allOf": [
        { "$ref": "#/$defs/scantorError" },
        { "properties": { "retryable": { "const": true } } }
      ]
    },
    "logTail": {
      "description": "Captured output of the failed attempt, at most 4 KiB (bytes enforced by the runtime).",
      "type": "string",
      "maxLength": 4096
    },
    "timings": { "$ref": "#/$defs/timings" }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-(0|[1-9][0-9]{0,15})$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epochMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scantorError": {
      "description": "The unified, runtime-owned error (docs/runtime.md section 9). Times are epoch milliseconds in AMQP bodies.",
      "type": "object",
      "required": ["type", "message", "retryable", "phase", "attempt", "at"],
      "properties": {
        "type": { "description": "ScantorError type. cancelled is never published (aborted scan work is given back or dropped with the queue), so it is not accepted here.", "enum": ["taskError", "fatal", "retry", "timeout", "crash", "validation", "platform"] },
        "message": { "type": "string", "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "phase": { "enum": ["bootstrap", "schedule", "run", "validate", "upload", "publish", "platform", "ingest"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 20 },
        "stack": { "type": ["string", "null"], "maxLength": 16384 },
        "details": { "type": ["object", "null"] },
        "at": { "$ref": "#/$defs/epochMs" }
      },
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "required": ["scheduledAt", "startedAt", "finishedAt", "durationMs"],
      "properties": {
        "scheduledAt": { "$ref": "#/$defs/epochMs" },
        "startedAt": { "$ref": "#/$defs/epochMs" },
        "finishedAt": { "$ref": "#/$defs/epochMs" },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "v": 1,
      "kind": "attempt",
      "analysisId": "5e1f0c2d-8a7b-4c3d-9e1f-2a3b4c5d6e7f-1234",
      "scanId": "5e1f0c2d-8a7b-4c3d-9e1f-2a3b4c5d6e7f",
      "seq": 1234,
      "round": 1,
      "attempt": 1,
      "executionId": "a1c0b9d8-7e6f-4a5b-8c4d-3e2f1a0b9c8d",
      "workerId": "9b8a7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
      "nodeId": "2d9e4f1a-6b7c-4d8e-9f0a-1b2c3d4e5f6a",
      "config": { "origin": "https://example.org" },
      "error": { "type": "timeout", "message": "run exceeded 30000 ms", "retryable": true, "phase": "run", "attempt": 1, "at": 1761040890000 },
      "logTail": "fetching https://example.org\n",
      "timings": { "scheduledAt": 1761040805000, "startedAt": 1761040860000, "finishedAt": 1761040890000, "durationMs": 30000 }
    }
  ]
}
