{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lonetis/scantor/main/schemas/messages/result.schema.json",
  "title": "Result message",
  "description": "Body of an AMQP message on exchange scantor.results (routing key <scanId>, AMQP user_id scan-<scanId>, type result), consumed by the ingestor from scantor.results.ingest. Published by a runner when an analysis reaches a final outcome. Scan identity is taken from user_id, never from this body; the body must agree with it. Size limits in bytes (result, logTail, whole message) are enforced by the runtime and the ingestor. See docs/queue.md section 5.3.",
  "type": "object",
  "required": [
    "v", "kind", "analysisId", "scanId", "seq", "round", "attempt", "executionId", "workerId", "nodeId",
    "config", "status", "result", "error", "files", "logTail", "timings"
  ],
  "properties": {
    "v": { "const": 1 },
    "kind": { "const": "result" },
    "analysisId": {
      "description": "<scanId>-<seq>.",
      "$ref": "#/$defs/analysisId"
    },
    "scanId": { "$ref": "#/$defs/uuid" },
    "seq": { "$ref": "#/$defs/seq" },
    "round": { "type": "integer", "minimum": 1 },
    "attempt": {
      "description": "The attempt that produced this outcome.",
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "executionId": {
      "description": "Fresh uuid of the delivery's execution.",
      "$ref": "#/$defs/uuid"
    },
    "workerId": { "$ref": "#/$defs/uuid" },
    "nodeId": { "$ref": "#/$defs/uuid" },
    "config": {
      "description": "The analysis config, copied from the analysis message.",
      "type": "object"
    },
    "status": { "enum": ["succeeded", "failed"] },
    "result": {
      "description": "The typed result (object) when succeeded, null when failed. At most SCANTOR_MAX_RESULT_BYTES serialized.",
      "type": ["object", "null"]
    },
    "error": {
      "description": "The final error when failed, null when succeeded.",
      "oneOf": [
        { "$ref": "#/$defs/scantorError" },
        { "type": "null" }
      ]
    },
    "files": {
      "description": "Files uploaded by this execution (empty when failed). S3 keys are never sent; the ingestor derives them.",
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/fileRef" }
    },
    "logTail": {
      "description": "Captured output of this attempt, at most 32 KiB (bytes enforced by the runtime).",
      "type": "string",
      "maxLength": 32768
    },
    "timings": { "$ref": "#/$defs/timings" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": {
        "properties": {
          "result": { "type": "object" },
          "error": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "result": { "type": "null" },
          "error": { "$ref": "#/$defs/scantorError" },
          "files": { "maxItems": 0 }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-(0|[1-9][0-9]{0,15})$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "epochMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "scantorError": {
      "description": "The unified, runtime-owned error (docs/runtime.md section 9). Times are epoch milliseconds in AMQP bodies.",
      "type": "object",
      "required": ["type", "message", "retryable", "phase", "attempt", "at"],
      "properties": {
        "type": { "description": "ScantorError type. cancelled is never published (aborted scan work is given back or dropped with the queue), so it is not accepted here.", "enum": ["taskError", "fatal", "retry", "timeout", "crash", "validation", "platform"] },
        "message": { "type": "string", "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "phase": { "enum": ["bootstrap", "schedule", "run", "validate", "upload", "publish", "platform", "ingest"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 20 },
        "stack": { "type": ["string", "null"], "maxLength": 16384 },
        "details": { "type": ["object", "null"] },
        "at": { "$ref": "#/$defs/epochMs" }
      },
      "additionalProperties": false
    },
    "fileRef": {
      "type": "object",
      "required": ["id", "name", "size", "sha256", "contentType"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "description": "1-255 characters without NUL, / or \\ (same rule as the protocol file message).", "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\\\x00]+$" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contentType": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "required": ["scheduledAt", "startedAt", "finishedAt", "durationMs"],
      "properties": {
        "scheduledAt": { "$ref": "#/$defs/epochMs" },
        "startedAt": { "$ref": "#/$defs/epochMs" },
        "finishedAt": { "$ref": "#/$defs/epochMs" },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "v": 1,
      "kind": "result",
      "analysisId": "5e1f0c2d-8a7b-4c3d-9e1f-2a3b4c5d6e7f-1234",
      "scanId": "5e1f0c2d-8a7b-4c3d-9e1f-2a3b4c5d6e7f",
      "seq": 1234,
      "round": 1,
      "attempt": 2,
      "executionId": "b2f1c0d9-8e7a-4b6c-9d5e-4f3a2b1c0d9e",
      "workerId": "9b8a7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
      "nodeId": "2d9e4f1a-6b7c-4d8e-9f0a-1b2c3d4e5f6a",
      "config": { "origin": "https://example.org" },
      "status": "succeeded",
      "result": {
        "status": 200,
        "title": "Example",
        "screenshot": { "id": "e0c4b2a1-9f8e-4d7c-8b6a-5f4e3d2c1b0a", "name": "screenshot.png", "size": 48213, "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08", "contentType": "image/png" }
      },
      "error": null,
      "files": [
        { "id": "e0c4b2a1-9f8e-4d7c-8b6a-5f4e3d2c1b0a", "name": "screenshot.png", "size": 48213, "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08", "contentType": "image/png" }
      ],
      "logTail": "fetching https://example.org\n",
      "timings": { "scheduledAt": 1761040805000, "startedAt": 1761040896000, "finishedAt": 1761040897200, "durationMs": 1200 }
    },
    {
      "v": 1,
      "kind": "result",
      "analysisId": "5e1f0c2d-8a7b-4c3d-9e1f-2a3b4c5d6e7f-77",
      "scanId": "5e1f0c2d-8a7b-4c3d-9e1f-2a3b4c5d6e7f",
      "seq": 77,
      "round": 1,
      "attempt": 3,
      "executionId": "c3e2d1f0-9a8b-4c7d-8e6f-5a4b3c2d1e0f",
      "workerId": "9b8a7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d",
      "nodeId": "2d9e4f1a-6b7c-4d8e-9f0a-1b2c3d4e5f6a",
      "config": { "origin": "https://unreachable.example" },
      "status": "failed",
      "result": null,
      "error": {
        "type": "taskError",
        "message": "ConnectionResetError: [Errno 104] Connection reset by peer",
        "retryable": true,
        "phase": "run",
        "attempt": 3,
        "stack": "Traceback (most recent call last):\n  File \"/task/main.py\", line 21, in run\n",
        "at": 1761040990000
      },
      "files": [],
      "logTail": "",
      "timings": { "scheduledAt": 1761040805000, "startedAt": 1761040985000, "finishedAt": 1761040990000, "durationMs": 5000 }
    }
  ]
}
