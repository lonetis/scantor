{
  "name": "scantor-tests",
  "private": true,
  "type": "module",
  "description": "Dockerized Playwright suite of scantor (docs/testing.md \u00a77)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "1.64.1",
    "ajv": "^8.20.0",
    "amqplib": "^2.2.0",
    "tar-stream": "^3.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 160,
    "trailingComma": "all",
    "overrides": [
      {
        "files": [
          "*.yml",
          "*.yaml"
        ],
        "options": {
          "singleQuote": false
        }
      }
    ]
  }
}
