          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d",
          "type": "file",
          "content": "x"
