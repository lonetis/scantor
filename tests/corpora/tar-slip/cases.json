      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d"
      }
    },
    {
