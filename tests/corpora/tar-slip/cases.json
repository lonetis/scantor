    {
      "id": "ok-normalised",
      "description": "a valid archive: ./ prefixes, modes normalised, .git/ dropped",
      "entries": [
        {
          "name": "./",
          "type": "dir"
        },
        {
          "name": "./scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n",
          "mode": 384
        },
        {
          "name": "./bin/",
          "type": "dir",
          "mode": 448
        },
        {
          "name": "./bin/run.sh",
          "type": "file",
          "content": "#!/bin/sh\n",
          "mode": 448
        },
        {
          "name": "./lib/util.py",
          "type": "file",
          "content": "x = 1\n",
          "mode": 438
        },
        {
          "name": "./.git/config",
          "type": "file",
          "content": "[core]\n"
        },
        {
          "name": "./sub/.git/HEAD",
          "type": "file",
          "content": "ref: x\n"
        }
