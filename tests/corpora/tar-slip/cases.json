{
  "version": 1,
  "description": "Archive cases for the workspace helper `extract` (docs/editor.md §9.5, docs/security.md WS-3). Each case describes the entries of an upload archive; the consumer builds the archive (format tar.gz unless `format` is zip; `raw` replaces the archive with these literal bytes), optionally prepares the user's workspace (`workspace`: entries created below the workspace root before the run, `symlink` = link target), runs extract with the default limits overridden by `limits` (maxFiles, maxBytes, maxPackBytes, maxWorkspaceBytes), and checks `expect`: a failure with the helper error `code` (and `path`, the offending archive path, when given), or success with exactly `tree` in the staging tree (lstat; mode = permission bits). Entry fields: `name` (or `nameBase64` for bytes that JSON cannot carry), `type` (file|dir|symlink|hardlink|char|block|fifo), `content` (UTF-8), `zeros` (that many zero bytes, streamed), `random` (that many incompressible bytes), `mode` (permission bits, default 0644/0755), `linkname`, `devmajor`/`devminor`, `declaredSize` (zip: the uncompressed size written into the headers), `generate` ({prefix, count, content}: count files named <prefix><i>) and `globalPax` (a PAX global header with these records). Names with NUL, invalid UTF-8 or more than 100 bytes are written with PAX path records.",
  "manifest": "scantor: 1\nname: slip\nlanguage: python\n",
  "cases": [
    {
      "id": "dotdot",
      "description": "an entry that leaves the root with ../",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "../x",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "../x"
      }
    },
    {
      "id": "absolute",
      "description": "an absolute entry name",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "/abs",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "/abs"
      }
    },
    {
      "id": "inner-dotdot",
      "description": "a .. segment inside the name (a/../../x)",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "a/../../x",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "a/../../x"
      }
    },
    {
      "id": "dot-segment",
      "description": "a . segment inside the name",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "a/./b",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "a/./b"
      }
    },
    {
      "id": "empty-segment",
      "description": "an empty segment (a//b)",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "a//b",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "a//b"
      }
    },
    {
      "id": "backslash",
      "description": "a Windows separator",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "a\\..\\..\\x",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "a\\..\\..\\x"
      }
    },
    {
      "id": "nul",
      "description": "a NUL byte in the name (zip: tar readers cannot carry NUL in names)",
      "format": "zip",
      "entries": [
        {
          "name": "scantor.yaml",
          "type": "file",
          "content": "scantor: 1\nname: slip\nlanguage: python\n"
        },
        {
          "name": "a\u0000b",
          "type": "file",
          "content": "x"
        }
      ],
      "expect": {
        "ok": false,
        "code": "invalidPath",
        "path": "a\u0000b"
      }
    },
    {
      "id": "invalid-utf8",
