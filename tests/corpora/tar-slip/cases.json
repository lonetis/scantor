      "expect": {
        "ok": true,
        "tree": [
          {
            "path": "bin",
            "type": "dir",
            "mode": 493
          },
          {
            "path": "bin/run.sh",
            "type": "file",
            "mode": 493
          },
          {
            "path": "lib",
            "type": "dir",
            "mode": 493
          },
          {
            "path": "lib/util.py",
            "type": "file",
            "mode": 420
          },
          {
            "path": "scantor.yaml",
            "type": "file",
            "mode": 420
          }
        ]
      }
    },
