# Non-secret settings of the test stack (docs/testing.md §7.3). The runner writes the stack's .env from
# .env.example, replaces every value named here, randomises the -insecure-dev secrets and adds a random
# SCANTOR_ADMIN_PASSWORD and the test CA as SCANTOR_CA_CERT. Every key must exist in .env.example.

# The production Traefik mode with locally built images (tag dev, no registry prefix)
COMPOSE_PROFILES=traefik
SCANTOR_IMAGE_PREFIX=
SCANTOR_IMAGE_TAG=dev

# One HTTPS origin per host, served by Traefik with the test CA's wildcard certificate
SCANTOR_DOMAIN=scantor.localhost
SCANTOR_PUBLIC_URL=https://scantor.localhost
SCANTOR_EDITOR_URL=https://editor.scantor.localhost
SCANTOR_S3_PUBLIC_URL=https://s3.scantor.localhost
SCANTOR_AMQP_PUBLIC_URL=amqps://amqp.scantor.localhost:443
SCANTOR_REGISTRY_PUBLIC_HOST=registry.scantor.localhost
SCANTOR_RUSTFS_CONSOLE_URL=https://rustfs.scantor.localhost
SCANTOR_TRAEFIK_CERT_RESOLVER=
SCANTOR_TRUST_PROXY=true
SCANTOR_TRAEFIK_BIND_ADDRESS=0.0.0.0

# Headless first admin (the runner generates the password)
SCANTOR_ADMIN_EMAIL=admin@scantor.test

# Data sources and git import from the fixtures server
SCANTOR_TRANCO_URL=http://fixtures.scantor.localhost:8089/tranco
SCANTOR_CRUX_URL=http://fixtures.scantor.localhost:8089/crux
SCANTOR_GIT_ALLOW_PRIVATE=true

# Short timings and small thresholds, so the behaviour behind them is testable with small scans
SCANTOR_NODE_OFFLINE_AFTER=20s
SCANTOR_SCAN_QUEUE_MAX_READY=500
SCANTOR_SCAN_CONFIRM_THRESHOLD=1000
SCANTOR_BREAKER_MIN_ATTEMPTS=20
SCANTOR_SCAN_STALL_AFTER=30s
SCANTOR_EDITOR_IDLE_TIMEOUT=3m

# Room for parallel e2e scans on the built-in node; placement still caps them by CPUs and memory
SCANTOR_BUILTIN_NODE_MAX_WORKERS=16
# The runner's disk is shared with the developer's machine or a small CI disk
SCANTOR_NODE_MIN_FREE_DISK=1GiB
